---
import '../styles/global.css';
import { m, rich, fill, formatDate } from '../lib/text';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';

interface Source { label: string; url?: string }
interface Props {
  /** Page path, e.g. "/check/". */
  path: string;
  wide?: boolean;
  title: string;
  description?: string;
  lastVerified?: string;
  sources?: Source[];
}

const { path, title, description, lastVerified, sources = [], wide = false } = Astro.props;
const site = Astro.site!;
const fullTitle = path === '/' ? `${m.meta.siteName}: ${title}` : `${title} · ${m.meta.siteName}`;
const nav = [
  ['/check/', m.nav.check],
  ['/register/', m.nav.register],
  ['/move/', m.nav.move],
  ['/deadlines/', m.nav.deadlines],
  ['/about/', m.nav.about],
] as const;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description ?? m.meta.description} />
    <link rel="canonical" href={new URL(path, site)} />
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#faf9f6" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description ?? m.meta.description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <a class="skip" href="#main">{m.nav.skip}</a>
    <header class="site-header">
      <div class="container bar">
        <a class="brand" href="/" translate="no">
          <img src="/logo.svg" width="40" height="40" alt="" aria-hidden="true" />
          <span>{m.meta.siteName}</span>
        </a>
        <LanguageSwitcher path={path} label={m.nav.language} />
      </div>
      <nav class="container" aria-label={m.nav.menu}>
        <ul class="nav">
          {nav.map(([href, label]) => (
            <li><a href={href} aria-current={href === path ? 'page' : undefined}>{label}</a></li>
          ))}
        </ul>
      </nav>
    </header>


    <main id="main" class:list={["container", { wide }]}>
      <slot />
      {(lastVerified || sources.length > 0) && (
        <aside class="provenance muted">
          {lastVerified && <p>{fill(m.common.lastVerified, { date: formatDate(lastVerified) })}</p>}
          {sources.length > 0 && (
            <details>
              <summary>{m.common.sources}</summary>
              <ul translate="no">
                {sources.map((s) => <li>{s.url ? <a href={s.url}>{s.label}</a> : s.label}</li>)}
              </ul>
            </details>
          )}
        </aside>
      )}
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <p class="helpline" set:html={rich(m.common.helpline)} />
          <p class="muted">{m.common.helplineNote}</p>
        </div>
        <p class="muted">{m.common.notAffiliated}</p>
      </div>
    </footer>

    <script is:inline src="/counter.js" defer></script>
  </body>
</html>

<style>
  .site-header { border-block-start: 3px solid var(--ink-strong); border-block-end: 1px solid var(--border); }
  .bar { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--space-4); min-height: 92px; padding-block: var(--space-3); }
  .brand {
    display: inline-flex; align-items: center; gap: var(--space-3); min-height: 48px;
    font-family: var(--heading-font); font-size: 1.75rem; font-weight: 700;
    letter-spacing: -0.04em; color: var(--ink-strong); text-decoration: none;
  }
  .brand img { display: block; flex: none; width: 40px; height: 40px; object-fit: contain; }
  .nav { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0 var(--space-8); }
  .nav li { margin: 0; }
  .nav a {
    display: inline-flex; align-items: center; min-height: 48px; padding-block: var(--space-2);
    border-block-end: 2px solid transparent; color: var(--muted);
    text-decoration: none; font-size: 0.9375rem; font-weight: 550;
  }
  .nav a:hover, .nav a[aria-current='page'] { border-color: var(--ink); color: var(--ink-strong); }
  .nav a[aria-current='page'] { font-weight: 700; }
  main { max-width: 50rem; padding-block: clamp(32px, 6vw, 64px) var(--space-16); }
  main.wide { max-width: 76rem; }
  .provenance { margin-block-start: var(--space-12); border-block-start: 1px solid var(--border); padding-block-start: var(--space-4); }
  .provenance summary { cursor: pointer; min-height: 44px; display: flex; align-items: center; font-weight: 600; }
  .site-footer { border-block-start: 1px solid var(--border); padding-block: var(--space-8); }
  .footer-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-12); }
  .footer-grid p:last-child { margin-block-end: 0; }
  .helpline { font-size: 1.125rem; margin-block-end: var(--space-2); color: var(--ink-strong); }
  @media (max-width: 600px) {
    .bar { min-height: 76px; }
    .brand { font-size: 1.5rem; gap: var(--space-2); }
    .brand img { width: 32px; height: 32px; }
    .nav { gap: 0 var(--space-4); }
    .nav a { font-size: 0.875rem; }
    .footer-grid { grid-template-columns: 1fr; gap: var(--space-6); }
  }
</style>
