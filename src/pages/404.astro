---
import Base from '../layouts/Base.astro';
import { defaultLocale } from '../i18n/locales';
import { getMessages } from '../i18n/t';

const m = getMessages('en');
---
<Base locale={defaultLocale} path="/404/" alternates={false} title={m.notFound.title}>
  <h1>{m.notFound.title}</h1>
  <p><a href="/">{m.notFound.body}</a></p>
</Base>
