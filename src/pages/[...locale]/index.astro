---
import Base from '../../layouts/Base.astro';
import Illustration from '../../components/Illustration.astro';
import { getLocale, locales, localeStaticPaths } from '../../i18n/locales';
import { getMessages, localePath } from '../../i18n/t';

export const getStaticPaths = localeStaticPaths;
const locale = getLocale(Astro.params.locale);
const m = getMessages(locale.code);
const tasks = [
  { href: '/check/', ill: 'search', ...m.home.tasks.check },
  { href: '/register/', ill: 'form', ...m.home.tasks.register },
  { href: '/move/', ill: 'move', ...m.home.tasks.move },
  { href: '/deadlines/', ill: 'receipt', ...m.home.tasks.deadlines },
] as const;
---
<Base locale={locale} path="/" title={m.home.title}>
  <h1>{m.home.title}</h1>
  <p class="lead">{m.home.lead}</p>

  <ul class="tasks">
    {tasks.map((t) => (
      <li>
        <a class="card task" href={localePath(locale, t.href)}>
          <Illustration name={t.ill} />
          <span>
            <strong>{t.title}</strong>
            <span class="muted">{t.body}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>

  <h2>{m.home.whyTitle}</h2>
  <p>{m.home.why}</p>

  <h2>{m.home.languagesTitle}</h2>
  <ul class="langs">
    {locales.map((l) => (
      <li><a href={localePath(l, '/')} lang={l.code} hreflang={l.code} aria-current={l.code === locale.code ? 'true' : undefined}>{l.name}</a></li>
    ))}
  </ul>
</Base>

<style>
  .tasks { list-style: none; padding: 0; display: grid; gap: 12px; margin-block: 24px; }
  .tasks li { margin: 0; }
  .task { display: flex; gap: 14px; align-items: center; text-decoration: none; color: var(--text); min-height: 96px; }
  .task:hover { border-color: var(--ink); }
  .task strong { display: block; font-size: 1.15rem; color: var(--ink-strong); margin-block-end: 2px; }
  .task .muted { display: block; }
  @media (min-width: 720px) { .tasks { grid-template-columns: 1fr 1fr; } }
  .langs { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr)); gap: 8px; }
  .langs li { margin: 0; }
  .langs a {
    display: flex; align-items: center; justify-content: center; min-height: 48px; padding: 6px 10px;
    border: 1px solid var(--border); border-radius: 10px; background: var(--surface);
    text-decoration: none; color: var(--ink-strong); font-weight: 600; text-align: center;
  }
  .langs a[aria-current] { background: var(--ink); color: var(--bg); border-color: var(--ink); }
</style>
