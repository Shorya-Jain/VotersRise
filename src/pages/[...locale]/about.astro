---
import Base from '../../layouts/Base.astro';
import { getLocale, localeStaticPaths } from '../../i18n/locales';
import { getMessages } from '../../i18n/t';

export const getStaticPaths = localeStaticPaths;
const locale = getLocale(Astro.params.locale);
const m = getMessages(locale.code);
const a = m.about;
---
<Base locale={locale} path="/about/" title={a.title} description={a.lead}>
  <h1>{a.title}</h1>
  <p class="lead">{a.lead}</p>
  <p>{a.why}</p>
  <h2>{a.independentTitle}</h2>
  <p>{a.independent}</p>
  <h2>{a.accuracyTitle}</h2>
  <p>{a.accuracy}</p>
  <h2>{a.translationTitle}</h2>
  <p>{a.translation}</p>
</Base>
