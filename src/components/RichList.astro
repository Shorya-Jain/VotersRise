---
import { rich } from '../lib/text';
interface Props { items: string[]; ordered?: boolean; check?: boolean }
const { items, ordered = false, check = false } = Astro.props;
const Tag = ordered ? 'ol' : 'ul';
---
<Tag class:list={{ check }}>
  {items.map((s) => <li set:html={rich(s)} />)}
</Tag>

<style>
  .check { list-style: none; padding-inline-start: 0; }
  .check li { position: relative; padding-inline-start: 1.9em; }
  .check li::before {
    content: '✓'; position: absolute; inset-inline-start: 0; color: var(--ink); font-weight: 700;
  }
</style>
