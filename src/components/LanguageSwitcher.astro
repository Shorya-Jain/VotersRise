---
import LanguageList from './LanguageList.astro';

interface Props { path: string; label: string }
const { path, label } = Astro.props;
---
<details class="lang">
  <summary aria-label={label}>
    <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3.5 3 14.5 0 18M12 3c-3 3.5-3 14.5 0 18"/></svg>
    <span translate="no">English</span>
  </summary>
  <div class="panel">
    <LanguageList path={path} variant="menu" />
  </div>
</details>

<style>
  .lang { position: relative; }
  summary {
    list-style: none; cursor: pointer; display: inline-flex; align-items: center; gap: var(--space-2);
    min-height: 44px; padding: var(--space-2) var(--space-3); border: 1px solid var(--control-border); border-radius: var(--radius);
    color: var(--ink-strong); font-weight: 600;
  }
  summary::-webkit-details-marker { display: none; }
  .panel {
    position: absolute; inset-inline-end: 0; z-index: 5; margin-block-start: 6px; padding: 6px;
    width: min(18rem, calc(100vw - 32px)); max-height: 70vh; overflow-y: auto;
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
    box-shadow: 0 8px 20px rgb(0 0 0 / 0.08);
  }
</style>
