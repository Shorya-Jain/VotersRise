---
// Language links. Each opens this page through Google Translate's website proxy
// (https://<host>.translate.goog/...), which translates it and keeps the layout.
import { languages, proxyUrl } from '../lib/languages';

interface Props { path: string; variant: 'menu' | 'grid' }
const { path, variant } = Astro.props;
// Previews translate their own deployment. Production always uses the stable site
// URL: CF_PAGES_URL is a per-deployment snapshot address (e.g. https://df31b805.votersrise.pages.dev),
// so shared or bookmarked translated links would keep showing an old version.
const isPreview = process.env.CF_PAGES_BRANCH !== undefined && process.env.CF_PAGES_BRANCH !== 'main';
const site = new URL(isPreview && process.env.CF_PAGES_URL ? process.env.CF_PAGES_URL : Astro.site!.href);
---
<ul class:list={['langs', variant]} translate="no">
  {languages.map((l) => (
    <li>
      <a
        href={l.code === 'en' ? path : proxyUrl(site, path, l.code)}
        lang={l.code}
        aria-current={l.code === 'en' ? 'true' : undefined}
      >
        {l.name}{variant === 'menu' && l.code !== 'en' && <span class="en" lang="en"> · {l.englishName}</span>}
      </a>
    </li>
  ))}
</ul>

<style>
  .langs { list-style: none; margin: 0; padding: 0; }
  .langs li { margin: 0; }
  .menu a {
    display: flex; flex-wrap: wrap; align-items: center; min-height: 44px; padding: 4px 12px; border-radius: var(--radius);
    color: var(--text); text-decoration: none;
  }
  .menu a:hover { background: var(--ink-soft); }
  .menu a[aria-current] { font-weight: 700; color: var(--ink-strong); background: var(--ink-soft); }
  .en { color: var(--muted); font-size: 0.9em; white-space: normal; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(7rem, 1fr)); gap: 0 var(--space-4); }
  .grid a {
    display: flex; align-items: center; justify-content: flex-start; min-height: 48px; padding: var(--space-2) 0;
    border-block-end: 1px solid var(--border);
    text-decoration: none; color: var(--ink-strong); font-weight: 600; text-align: start;
  }
  .grid a:hover, .grid a[aria-current] { text-decoration: underline; border-color: var(--ink); }
</style>
